# --- Required -------------------------------------------------------------
# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Never expose in client code or commit it.
# Needed for inviting users, disabling sessions, the scheduled job and the bootstrap script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used in invitation and password-reset links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random secret; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=generate-a-long-random-string

# --- Optional: email delivery (notification digests, scheduled reports) ----
RESEND_API_KEY=
EMAIL_FROM="LinkOps <reports@your-domain.com>"
# NON-PRODUCTION ONLY: send email only to these recipients ("@domain" or full addresses,
# comma-separated). Staging gets "@resend.dev" from scripts/staging-env.mjs. Leave unset in production.
# EMAIL_ALLOWED_RECIPIENTS=@resend.dev

# --- Rate-limit client IP (needed on hosts other than Vercel / Cloudflare) --------
# Name a header that YOUR host's proxy overwrites or appends to. Vercel and Cloudflare Workers are
# detected automatically. If neither applies and this is empty, IP-based sign-in limits are off
# (per-email limits still apply) — the app never trusts headers a visitor could send.
#   CLIENT_IP_HEADER=x-forwarded-for   + TRUSTED_PROXY_HOPS=1  (entry appended by your proxy, from the right)
#   CLIENT_IP_HEADER=true-client-ip    (single-value header set by e.g. a Cloudflare proxy in front)
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=1
